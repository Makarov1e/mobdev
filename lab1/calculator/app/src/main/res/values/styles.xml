<resources>
    <style name="Theme.Calculator" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#FF9F0A</item>
        <item name="android:windowBackground">#1C1C1E</item>
    </style>

    <style name="CalcBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalcBtn.Dark" parent="CalcBtn">
        <item name="android:backgroundTint">#3A3A3C</item>
    </style>

    <style name="CalcBtn.Gray" parent="CalcBtn">
        <item name="android:backgroundTint">#636366</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="CalcBtn.Orange" parent="CalcBtn">
        <item name="android:backgroundTint">#FF9F0A</item>
    </style>
</resources>
