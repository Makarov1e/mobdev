<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1E"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:gravity="end|bottom"
        android:padding="16dp"
        android:textSize="48sp"
        android:textColor="#FFFFFF"
        android:maxLines="2"
        android:ellipsize="start"
        android:text="0" />

    <!-- Row 1: C  +/-  %  ÷ -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btnClear"     style="@style/CalcBtn.Gray"   android:text="C"   android:layout_weight="1"/>
        <Button android:id="@+id/btnPlusMinus" style="@style/CalcBtn.Gray"   android:text="+/-" android:layout_weight="1"/>
        <Button android:id="@+id/btnPercent"   style="@style/CalcBtn.Gray"   android:text="%"   android:layout_weight="1"/>
        <Button android:id="@+id/btnDiv"       style="@style/CalcBtn.Orange" android:text="÷"   android:layout_weight="1"/>
    </LinearLayout>

    <!-- Row 2: 7  8  9  × -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn7"   style="@style/CalcBtn.Dark"   android:text="7" android:layout_weight="1"/>
        <Button android:id="@+id/btn8"   style="@style/CalcBtn.Dark"   android:text="8" android:layout_weight="1"/>
        <Button android:id="@+id/btn9"   style="@style/CalcBtn.Dark"   android:text="9" android:layout_weight="1"/>
        <Button android:id="@+id/btnMul" style="@style/CalcBtn.Orange" android:text="×" android:layout_weight="1"/>
    </LinearLayout>

    <!-- Row 3: 4  5  6  − -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn4"     style="@style/CalcBtn.Dark"   android:text="4" android:layout_weight="1"/>
        <Button android:id="@+id/btn5"     style="@style/CalcBtn.Dark"   android:text="5" android:layout_weight="1"/>
        <Button android:id="@+id/btn6"     style="@style/CalcBtn.Dark"   android:text="6" android:layout_weight="1"/>
        <Button android:id="@+id/btnMinus" style="@style/CalcBtn.Orange" android:text="−" android:layout_weight="1"/>
    </LinearLayout>

    <!-- Row 4: 1  2  3  + -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn1"    style="@style/CalcBtn.Dark"   android:text="1" android:layout_weight="1"/>
        <Button android:id="@+id/btn2"    style="@style/CalcBtn.Dark"   android:text="2" android:layout_weight="1"/>
        <Button android:id="@+id/btn3"    style="@style/CalcBtn.Dark"   android:text="3" android:layout_weight="1"/>
        <Button android:id="@+id/btnPlus" style="@style/CalcBtn.Orange" android:text="+" android:layout_weight="1"/>
    </LinearLayout>

    <!-- Row 5: 0 (wide)  .  = -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn0"      style="@style/CalcBtn.Dark"   android:text="0" android:layout_weight="2"/>
        <Button android:id="@+id/btnDot"    style="@style/CalcBtn.Dark"   android:text="." android:layout_weight="1"/>
        <Button android:id="@+id/btnEquals" style="@style/CalcBtn.Orange" android:text="=" android:layout_weight="1"/>
    </LinearLayout>

</LinearLayout>
